APP_NAME="SIA MI Alghivari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sia_alghivari
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sia-alghivari.local"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb WebSocket Configuration
REVERB_APP_ID=sia-alghivari-app
REVERB_APP_KEY=sia-alghivari-key
REVERB_APP_SECRET=sia-alghivari-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Internal Backend Broadcast endpoint (Compose network)
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080

# Frontend Echo Public Client Build Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_REVERB_TUNNEL_TOKEN=
DB_ROOT_PASSWORD=
